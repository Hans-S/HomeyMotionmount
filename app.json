{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "net.thunderstone.motionmount",
  "version": "0.1.0",
  "compatibility": ">=5.0.0",
  "sdk": 3,
  "brandColor": "#455A64",
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Motionmounter",
    "nl": "Motionmounter"
  },
  "description": {
    "en": "Control Vogel's MotionMount",
    "nl": "Bedien je Vogel's MotionMount"
  },
  "category": [
    "appliances"
  ],
  "permissions": [
    "homey:wireless:ble"
  ],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png"
  },
  "author": {
    "name": "Hans Schotanus",
    "email": "joker-heckles.02@icloud.com"
  },
  "flow": {
    "actions": [
      {
        "id": "goto_position",
        "title": {
          "en": "Goto position",
          "nl": "Ga naar positie"
        },
        "titleFormatted": {
          "en": "Goto position: extend [[extend]], turn [[turn]]",
          "nl": "Ga naar positie: uitschuiven [[extend]], draaien [[turn]]"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=vogels"
          },
          {
            "name": "extend",
            "title": {
              "en": "Extend",
              "nl": "Uitschuiven"
            },
            "type": "number",
            "min": 0,
            "max": 100
          },
          {
            "name": "turn",
            "title": {
              "en": "Turn",
              "nl": "Draaien"
            },
            "type": "number",
            "min": -100,
            "max": 100
          }
        ]
      },
      {
        "id": "goto_preset",
        "title": {
          "en": "Goto preset",
          "nl": "Ga naar preset"
        },
        "titleFormatted": {
          "en": "Goto preset [[preset]]",
          "nl": "Ga naar preset [[preset]]"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=vogels"
          },
          {
            "name": "preset",
            "title": {
              "en": "Preset",
              "nl": "Preset"
            },
            "type": "autocomplete"
          }
        ]
      }
    ]
  },
  "drivers": [
    {
      "name": {
        "en": "MotionMount",
        "nl": "MotionMount"
      },
      "class": "tv",
      "capabilities": [
        "current_extend",
        "current_turn",
        "set_extend",
        "set_turn",
        "preset"
      ],
      "platforms": [
        "local"
      ],
      "connectivity": [
        "ble"
      ],
      "images": {
        "small": "/drivers/vogels/assets/images/small.png",
        "large": "/drivers/vogels/assets/images/large.png"
      },
      "pair": [
        {
          "id": "list_my_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_my_devices"
          }
        },
        {
          "id": "add_my_devices",
          "template": "add_devices"
        }
      ],
      "id": "vogels",
      "settings": [
        {
          "id": "polling",
          "type": "checkbox",
          "value": true,
          "label": {
            "en": "Polling",
            "nl": "Polling"
          },
          "hint": {
            "en": "When on, the app reads the mount every interval and keeps the sliders and current position tiles correct — also when the mount is moved outside the app. Turning this off leaves the sliders and position tiles stale until you next move the mount from within the app.",
            "nl": "Indien aan leest de app de mount elke interval uit en houdt de schuifregelaars en de tegels met de huidige positie correct — ook als de mount buiten de app om wordt bewogen. Uitschakelen laat de schuifregelaars en positietegels verouderd totdat je de mount weer vanuit de app beweegt."
          }
        },
        {
          "id": "polling_interval",
          "type": "number",
          "label": {
            "en": "Polling interval",
            "nl": "Polling-interval"
          },
          "hint": {
            "en": "How often the app reads the mount's position. Longer intervals reduce Bluetooth usage and contention with other apps.",
            "nl": "Hoe vaak de app de positie van de mount uitleest. Langere intervallen verminderen Bluetooth-gebruik en conflicten met andere apps."
          },
          "value": 300,
          "min": 60,
          "units": "seconds"
        }
      ]
    }
  ],
  "capabilities": {
    "current_extend": {
      "type": "string",
      "title": {
        "en": "Current extend",
        "nl": "Huidige uitschuifpositie"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/icon.svg"
    },
    "current_turn": {
      "type": "string",
      "title": {
        "en": "Current turn",
        "nl": "Huidige draaipositie"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/icon.svg"
    },
    "preset": {
      "type": "enum",
      "title": {
        "en": "Preset",
        "nl": "Preset"
      },
      "getable": true,
      "setable": true,
      "values": [
        {
          "id": "0",
          "title": {
            "en": "Preset 0",
            "nl": "Preset 0"
          }
        }
      ]
    },
    "set_extend": {
      "type": "number",
      "title": {
        "en": "Set extend",
        "nl": "Uitschuiven"
      },
      "getable": true,
      "setable": true,
      "uiComponent": "slider",
      "min": 0,
      "max": 100,
      "step": 1,
      "icon": "/assets/icon.svg"
    },
    "set_turn": {
      "type": "number",
      "title": {
        "en": "Set turn",
        "nl": "Draaien"
      },
      "getable": true,
      "setable": true,
      "uiComponent": "slider",
      "min": -100,
      "max": 100,
      "step": 1,
      "icon": "/assets/icon.svg"
    }
  }
}