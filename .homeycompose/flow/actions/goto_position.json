{
  "id": "goto_position",
  "title": {
    "en": "Goto position",
    "nl": "Ga naar positie"
  },
  "titleFormatted": {
    "en": "Goto position: extend [[extend]], turn [[turn]]",
    "nl": "Ga naar positie: uitschuiven [[extend]], draaien [[turn]]"
  },
  "args": [
    {
      "name": "device",
      "type": "device",
      "filter": "driver_id=vogels"
    },
    {
      "name": "extend",
      "title": {
        "en": "Extend",
        "nl": "Uitschuiven"
      },
      "type": "number",
      "min": 0,
      "max": 100
    },
    {
      "name": "turn",
      "title": {
        "en": "Turn",
        "nl": "Draaien"
      },
      "type": "number",
      "min": -100,
      "max": 100
    }
  ]
}